{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://router.luukhoahoc.me/v1"
      },
      "models": {
        "opencode-premium": {
          "name": "opencode-premium",
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "opencode-fast": {
          "name": "opencode-fast",
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "model": "9router/opencode-premium",
  "plugin": [
    "opencode-agent-skills",
    "oh-my-opencode-slim",
    "opencode-supermemory@latest"
  ],
  "skills": {
    "paths": [
      "$HOME/.config/opencode/skills/mattpocock"
    ]
  },
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free"
    },
    "explore": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "lsp": true
}
